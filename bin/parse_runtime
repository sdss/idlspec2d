#!/usr/bin/env python3

import click
from boss_drp.cli.SOS import run_parse_runtime as cmd
from boss_drp.utils.argparse_help import full_help_callback

@click.command(context_settings=dict(help_option_names=['-h', '--help'],max_content_width= 150)) 
@click.option(
    "--fullhelp",
    is_flag=True,
    is_eager=True,
    expose_value=False,
    callback=full_help_callback,
    hidden = True,
    help="Show full help including all subcommands"
)
@click.pass_context
def cli(ctx, **kwargs):
    # Forward everything to the existing command
    return ctx.invoke(cmd, **kwargs)


# Keep --fullhelp and add the original command params
cli.params = list(cmd.params) + [
    p for p in cli.params if p.name == "fullhelp"
]


if __name__ == "__main__":
    cli()


